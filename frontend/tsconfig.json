{
    "extends": "./.svelte-kit/tsconfig.json",
    "compilerOptions": {
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true
    },
    "exclude": ["node_modules"]
}